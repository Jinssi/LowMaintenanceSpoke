{
  "$comment": "Application Gateway v2 subnet rules (https://learn.microsoft.com/azure/application-gateway/configuration-infrastructure#network-security-groups).",
  "securityRules": [
    {
      "name": "Allow_GatewayManager",
      "properties": {
        "description": "Application Gateway v2 infrastructure ports.",
        "protocol": "Tcp",
        "sourceAddressPrefix": "GatewayManager",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "*",
        "destinationPortRange": "65200-65535",
        "access": "Allow",
        "priority": 100,
        "direction": "Inbound"
      }
    },
    {
      "name": "Allow_HTTPS",
      "properties": {
        "description": "Client HTTPS traffic.",
        "protocol": "Tcp",
        "sourceAddressPrefix": "*",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "*",
        "destinationPortRange": "443",
        "access": "Allow",
        "priority": 110,
        "direction": "Inbound"
      }
    },
    {
      "name": "Allow_HTTP",
      "properties": {
        "description": "Client HTTP traffic (redirected to HTTPS).",
        "protocol": "Tcp",
        "sourceAddressPrefix": "*",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "*",
        "destinationPortRange": "80",
        "access": "Allow",
        "priority": 120,
        "direction": "Inbound"
      }
    },
    {
      "name": "Allow_AzureLoadBalancer",
      "properties": {
        "description": "Azure Load Balancer health probes.",
        "protocol": "*",
        "sourceAddressPrefix": "AzureLoadBalancer",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "*",
        "destinationPortRange": "*",
        "access": "Allow",
        "priority": 130,
        "direction": "Inbound"
      }
    }
  ]
}
